{
  "name": "qpos-server",
  "version": "2.0.0",
  "description": "Backend API for QPOS.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:generate:master": "prisma generate --config prisma.master.config.ts",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:master": "prisma migrate dev --config prisma.master.config.ts",
    "prisma:migrate:master:status": "prisma migrate status --config prisma.master.config.ts",
    "master:bootstrap-default-store": "node dist/scripts/bootstrap-master-default-store.js",
    "prisma:studio": "prisma studio"
  },
  "keywords": [
    "qpos",
    "express",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/multer": "^2.2.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.1",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "node-thermal-printer": "^4.6.0",
    "pg": "^8.22.0",
    "printer": "^0.4.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.5",
    "prisma": "^7.8.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2"
  }
}
