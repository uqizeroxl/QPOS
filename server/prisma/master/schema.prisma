generator client {
  provider = "prisma-client"
  output   = "../../src/generated/master-prisma"
}

datasource db {
  provider = "postgresql"
}

enum StoreRole {
  OWNER
  MANAGER
  CASHIER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

enum TenantMigrationStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

model DeviceSession {
  id             String   @id @default(cuid())
  accountId      String
  deviceName     String?  @db.VarChar(200)
  deviceType     String?  @db.VarChar(50)
  browser        String?  @db.VarChar(100)
  os             String?  @db.VarChar(100)
  ipAddress      String?  @db.VarChar(50)
  tokenVersion   Int      @default(1)
  lastActiveAt   DateTime @default(now())
  createdAt      DateTime @default(now())

  account        Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("device_sessions")
}

model Account {
  id           String        @id @default(cuid())
  username     String        @unique @db.VarChar(80)
  name         String        @db.VarChar(120)
  passwordHash String        @default("") @db.VarChar(255)
  email        String?       @unique @db.VarChar(255)
  googleId     String?       @unique @db.VarChar(255)
  appleId      String?       @unique @db.VarChar(255)
  tiktokId     String?       @unique @db.VarChar(255)
  avatarUrl    String?       @db.Text
  isActive     Boolean       @default(true)
  tokenVersion Int           @default(0)
  memberships    StoreMember[]
  deviceSessions DeviceSession[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([username])
  @@index([email])
  @@map("accounts")
}

model Store {
  id             String                  @id @default(cuid())
  name           String                  @db.VarChar(150)
  isActive       Boolean                 @default(true)
  members        StoreMember[]
  invitations    StoreInvitation[]
  tenantRegistry TenantDatabaseRegistry?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([name])
  @@map("stores")
}

model StoreMember {
  id        String    @id @default(cuid())
  accountId String
  storeId   String
  role      StoreRole
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([accountId, storeId])
  @@index([accountId])
  @@index([storeId])
  @@index([role])
  @@map("store_members")
}

model TenantDatabaseRegistry {
  id              String                @id @default(cuid())
  storeId         String                @unique
  databaseUrl     String                @db.Text
  schemaVersion   String                @default("0") @db.VarChar(50)
  migrationStatus TenantMigrationStatus @default(PENDING)
  lastMigratedAt  DateTime?
  store           Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([migrationStatus])
  @@map("tenant_database_registries")
}

model StoreInvitation {
  id        String           @id @default(cuid())
  storeId   String
  email     String           @db.VarChar(255)
  token     String           @unique @db.VarChar(255)
  status    InvitationStatus @default(PENDING)
  expiresAt DateTime
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  store     Store            @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([storeId])
  @@index([token])
  @@index([email])
  @@map("store_invitations")
}
