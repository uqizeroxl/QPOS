generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RecordStatus {
  ACTIVE   @map("Aktif")
  INACTIVE @map("Nonaktif")
}

enum ActivityType {
  PRODUCT_CREATE      @map("product-create")
  PRODUCT_UPDATE      @map("product-update")
  PRODUCT_DELETE      @map("product-delete")
  CATEGORY_CREATE     @map("category-create")
  CATEGORY_UPDATE     @map("category-update")
  CATEGORY_DELETE     @map("category-delete")
  SUPPLIER_CREATE     @map("supplier-create")
  SUPPLIER_UPDATE     @map("supplier-update")
  SUPPLIER_DELETE     @map("supplier-delete")
  LOGIN               @map("login")
  LOGOUT              @map("logout")
  TRANSACTION_SUCCESS @map("transaction-success")
  TRANSACTION_HISTORY_RESET @map("transaction-history-reset")
  TRANSACTION_RETENTION @map("transaction-retention")
  BARCODE_PRINT       @map("barcode-print")
  RECEIPT_PRINT       @map("receipt-print")
  STOCK_RESTOCK       @map("stock-restock")
  STOCK_MINIMUM       @map("stock-minimum")
}

enum StockAdjustmentType {
  ADD
  REDUCE
  SET
}

enum StockReferenceType {
  SALE
  RESTOCK
  ADJUSTMENT
  PURCHASE_ORDER
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

enum NotificationType {
  SUCCESS @map("success")
  ERROR   @map("error")
  INFO    @map("info")
  WARNING @map("warning")
}

enum NotificationCategory {
  STOCK        @map("stock")
  PRODUCT      @map("product")
  CATEGORY     @map("category")
  BARCODE      @map("barcode")
  SUPPLIER     @map("supplier")
  SALES        @map("sales")
  ANNOUNCEMENT @map("announcement")
}

enum UserRole {
  OWNER
  ADMIN
  CASHIER
  WAREHOUSE
}

model Category {
  id          String       @id @default(cuid())
  name        String       @unique @db.VarChar(120)
  description String       @default("") @db.Text
  status      RecordStatus @default(ACTIVE)
  products    Product[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([name])
  @@map("categories")
}

model Supplier {
  id        String    @id @default(cuid())
  name      String    @unique @db.VarChar(150)
  phone     String?   @db.VarChar(30)
  email     String?   @db.VarChar(150)
  address   String?   @db.Text
  notes     String?   @db.Text
  isActive  Boolean   @default(true)
  products  Product[]
  purchaseOrders PurchaseOrder[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([name])
  @@map("suppliers")
}

model Product {
  id               String            @id @default(cuid())
  barcode          String?           @unique @db.VarChar(64)
  name             String            @db.VarChar(180)
  purchasePrice    Decimal?          @db.Decimal(14, 2)
  sellingPrice     Decimal           @default(0) @db.Decimal(14, 2)
  stock            Int               @default(0)
  minimumStock     Int               @default(5)
  status           RecordStatus      @default(ACTIVE)
  categoryId       String
  supplierId       String?
  category         Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  supplier         Supplier?         @relation(fields: [supplierId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  transactionItems TransactionItem[]
  stockHistories   StockHistory[]
  purchaseOrderItems PurchaseOrderItem[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([barcode])
  @@index([name])
  @@index([categoryId])
  @@index([supplierId])
  @@map("products")
}

model PurchaseOrder {
  id          String              @id @default(cuid())
  poNumber    String              @unique @db.VarChar(50)
  supplierId  String
  status      PurchaseOrderStatus @default(DRAFT)
  note        String              @default("") @db.Text
  supplier    Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  items       PurchaseOrderItem[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([poNumber])
  @@index([supplierId])
  @@index([status])
  @@index([createdAt])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  productId       String
  quantity        Int
  cost            Decimal       @db.Decimal(14, 2)
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  product         Product       @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_items")
}

model StockHistory {
  id            String              @id @default(cuid())
  productId     String
  type          StockAdjustmentType
  quantity      Int
  previousStock Int
  currentStock  Int
  referenceType StockReferenceType?
  referenceId   String?             @db.VarChar(191)
  userName      String?             @db.VarChar(120)
  note          String              @default("") @db.Text
  product       Product             @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt     DateTime            @default(now())

  @@index([productId])
  @@index([referenceType])
  @@index([referenceId])
  @@index([createdAt])
  @@map("stock_histories")
}

model Transaction {
  id              String            @id @default(cuid())
  invoiceNumber   String            @unique @db.VarChar(50)
  idempotencyKey  String?           @unique @db.VarChar(191)
  requestHash     String?           @db.VarChar(64)
  subtotal        Decimal           @default(0) @db.Decimal(14, 2)
  discountPercent Decimal           @default(0) @db.Decimal(5, 2)
  discountAmount  Decimal           @default(0) @db.Decimal(14, 2)
  grandTotal      Decimal           @default(0) @db.Decimal(14, 2)
  paidAmount      Decimal           @default(0) @db.Decimal(14, 2)
  change          Decimal           @default(0) @db.Decimal(14, 2)
  cashierName     String?           @db.VarChar(120)
  items           TransactionItem[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([invoiceNumber])
  @@index([createdAt])
  @@map("transactions")
}

model TransactionItem {
  id             String      @id @default(cuid())
  transactionId  String
  productId      String?
  productBarcode String      @db.VarChar(64)
  productName    String      @db.VarChar(180)
  categoryName   String      @default("") @db.VarChar(120)
  supplierName   String?     @db.VarChar(150)
  unitPrice      Decimal     @db.Decimal(14, 2)
  quantity       Int
  subtotal       Decimal     @db.Decimal(14, 2)
  transaction    Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  product        Product?    @relation(fields: [productId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([transactionId])
  @@index([productId])
  @@index([productBarcode])
  @@map("transaction_items")
}

model Settings {
  id            String   @id @default(cuid())
  key           String   @unique @default("default") @db.VarChar(50)
  storeName     String   @default("Toko Saya") @db.VarChar(150)
  phone         String   @default("") @db.VarChar(30)
  address       String   @default("") @db.Text
  receiptFooter String   @default("Terima kasih") @db.VarChar(250)
  thermalPaperWidth Int  @default(80)
  thermalPaperProfile String @default("80x80") @db.VarChar(20)
  receiptAutoCut Boolean @default(true)
  printerBackend String @default("NODE_THERMAL_PRINTER") @db.VarChar(20)
  selectedPrinterName String @default("") @db.VarChar(255)
  thermalPrinterType String @default("epson") @db.VarChar(20)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("settings")
}

model ActivityLog {
  id          String       @id @default(cuid())
  type        ActivityType
  title       String       @db.VarChar(150)
  description String       @db.Text
  metadata    Json?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([type])
  @@index([createdAt])
  @@map("activity_logs")
}

model Notification {
  id          String               @id @default(cuid())
  title       String               @db.VarChar(150)
  description String?              @db.Text
  message     String?              @db.Text
  type        NotificationType
  category    NotificationCategory @default(ANNOUNCEMENT)
  isRead      Boolean              @default(false)
  readAt      DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([category])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique @db.VarChar(80)
  name         String   @db.VarChar(120)
  passwordHash String   @db.VarChar(255)
  role         UserRole @default(CASHIER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([username])
  @@index([role])
  @@map("users")
}
